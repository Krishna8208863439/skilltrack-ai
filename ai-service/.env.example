# SkillTrack AI — AI Service Environment Variables
# Copy this to .env and fill in your values.

# ─── Server ───────────────────────────────────────────────────────────────────
HOST=0.0.0.0
PORT=8000
ENVIRONMENT=development

# ─── Database (read-only mirror or direct) ───────────────────────────────────
DATABASE_URL=postgresql://postgres:yourpassword@localhost:5432/skilltrack_ai

# ─── Model Config ─────────────────────────────────────────────────────────────
SPACY_MODEL=en_core_web_sm
SKILL_DICT_PATH=./data/skill_taxonomy.json
MAX_RESUME_SIZE_MB=10

# ─── Backend (for internal calls if needed) ──────────────────────────────────
BACKEND_URL=http://localhost:5000
