# SkillTrack AI — Backend Environment Variables
# Copy this to .env and fill in your values. NEVER commit .env to version control.

# ─── Server ───────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=5000

# ─── PostgreSQL (Prisma) ──────────────────────────────────────────────────────
DATABASE_URL="postgresql://postgres:yourpassword@localhost:5432/skilltrack_ai?schema=public"

# ─── JWT ─────────────────────────────────────────────────────────────────────
JWT_SECRET=change_this_to_a_long_random_secret_min_32_chars
JWT_EXPIRES_IN=7d
JWT_REFRESH_SECRET=change_this_to_another_long_random_secret
JWT_REFRESH_EXPIRES_IN=30d

# ─── AI Service ───────────────────────────────────────────────────────────────
AI_SERVICE_URL=http://localhost:8000

# ─── File Uploads ─────────────────────────────────────────────────────────────
UPLOAD_DIR=./uploads
MAX_FILE_SIZE_MB=10

# ─── Frontend CORS ────────────────────────────────────────────────────────────
FRONTEND_URL=http://localhost:5173

# ─── Rate Limiting ────────────────────────────────────────────────────────────
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100

# ─── Logging ──────────────────────────────────────────────────────────────────
LOG_LEVEL=debug
